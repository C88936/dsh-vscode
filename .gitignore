*.log
.tmp/
# A prepared offline bundle ships its verified closure as ordinary files: the
# installed dependency copy and its tarball are deliverables, not dependencies
# this checkout installed. Later patterns win, so these exceptions follow the
# node_modules/ and lib/ rules above.
!apps/vscode/deploy/encoded-source/node_modules/
!apps/vscode/deploy/encoded-source/node_modules/**
!apps/vscode/deploy/encoded-source/node_modules/**/lib/
!apps/vscode/deploy/encoded-source/node_modules/**/lib/**

