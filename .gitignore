# VS Code extension: build staging, packaged distributions and local state are
# produced artifacts, not sources. The managed runtime is 700 MB and is rebuilt
# by `runtime:standalone`; the VSIX files are release outputs.
apps/vscode/runtime/
apps/vscode/.runtime-staging-*/
apps/vscode/.vsix-staging/
